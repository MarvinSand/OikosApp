default_platform(:ios)

platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    # ASC_KEY_CONTENT kann entweder der rohe .p8-Inhalt (mit
    # -----BEGIN/END PRIVATE KEY-----) oder Base64-kodiert sein.
    raw_key_content = ENV["ASC_KEY_CONTENT"].to_s
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: raw_key_content,
      is_key_content_base64: !raw_key_content.include?("PRIVATE KEY"),
      in_house: false
    )

    setup_ci if ENV["CI"]

    match(
      type: "appstore",
      readonly: false,
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      app_identifier: ENV["APP_IDENTIFIER"]
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: ENV["TEAM_ID"],
      code_sign_identity: "iPhone Distribution",
      profile_name: "match AppStore #{ENV["APP_IDENTIFIER"]}",
      targets: ["App"]
    )

    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: ENV["BUILD_NUMBER"] || latest_testflight_build_number(api_key: api_key) + 1
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          ENV["APP_IDENTIFIER"] => "match AppStore #{ENV["APP_IDENTIFIER"]}"
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
