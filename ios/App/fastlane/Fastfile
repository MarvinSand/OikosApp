default_platform(:ios)

platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    # ASC_KEY_CONTENT kann entweder der rohe .p8-Inhalt (mit
    # -----BEGIN/END PRIVATE KEY-----) oder Base64-kodiert sein.
    raw_key_content = ENV["ASC_KEY_CONTENT"].to_s
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: raw_key_content,
      is_key_content_base64: !raw_key_content.include?("PRIVATE KEY"),
      in_house: false
    )

    setup_ci if ENV["CI"]

    match(
      type: "appstore",
      readonly: false,
      # true (Workflow-Input renew_profile): Profil neu erzeugen, z. B. nach neuer Capability
      force: ENV["MATCH_FORCE"] == "true",
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      app_identifier: ENV["APP_IDENTIFIER"]
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: ENV["TEAM_ID"],
      code_sign_identity: "iPhone Distribution",
      profile_name: "match AppStore #{ENV["APP_IDENTIFIER"]}",
      targets: ["App"]
    )

    build_number = (ENV["BUILD_NUMBER"] || latest_testflight_build_number(api_key: api_key) + 1).to_s
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: build_number
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          ENV["APP_IDENTIFIER"] => "match AppStore #{ENV["APP_IDENTIFIER"]}"
        }
      }
    )

    submit = ENV["SUBMIT_FOR_REVIEW"] == "true"

    # Beim direkten Einreichen muss der Build fertig verarbeitet sein, bevor er
    # der App-Store-Version zugeordnet werden kann.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: !submit
    )

    if submit
      version = get_version_number(xcodeproj: "App.xcodeproj", target: "App")
      # „Was ist neu“: Workflow-Eingabe, sonst die Datei fastlane/whats_new.txt
      whats_new = ENV["WHATS_NEW"].to_s.strip
      whats_new = File.read(File.join(__dir__, "whats_new.txt")).strip if whats_new.empty?
      UI.user_error!("'Was ist neu' fehlt (fastlane/whats_new.txt).") if whats_new.empty?

      # Legt die App-Store-Version an (falls es noch keine bearbeitbare gibt),
      # trägt „Was ist neu“ ein, wählt den neuen Build und reicht zur Prüfung
      # ein. Veröffentlichung nach der Freigabe bleibt manuell.
      upload_to_app_store(
        api_key: api_key,
        app_identifier: ENV["APP_IDENTIFIER"],
        app_version: version,
        build_number: build_number,
        skip_binary_upload: true,
        skip_screenshots: true,
        release_notes: { "default" => whats_new },
        submit_for_review: true,
        automatic_release: false,
        force: true,
        run_precheck_before_submit: false,
        precheck_include_in_app_purchases: false,
        submission_information: {
          add_id_info_uses_idfa: false
        }
      )
    end
  end
end
